<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>T8000X - 账号设置</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
body{background:#fff;display:flex;justify-content:center;align-items:center;min-height:100vh;padding:20px;position:relative}
.bg-grid{position:fixed;top:0;left:0;right:0;bottom:0;background-image:linear-gradient(rgba(0,0,0,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,0,0,0.03) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;z-index:0}
.container{width:100%;max-width:380px;position:relative;z-index:1}
.icon,.icon-sm,.icon-md,.icon-gray{display:inline-block;vertical-align:middle;flex-shrink:0;width:16px;height:16px;filter:brightness(0)saturate(100%)}
.icon-sm{width:14px;height:14px}
.icon-md{width:18px;height:18px}
.icon-gray{filter:brightness(0)saturate(0%)opacity(0.6)}
.spinner{animation:spin 1.5s linear infinite}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.avatar-section{text-align:center;margin-bottom:20px}
#avatarContainer{display:inline-block;width:80px;height:80px;border-radius:50%;border:3px solid #0a0a0a;overflow:hidden;background:#e5e7eb;position:relative;transition:border-color .3s;flex-shrink:0}
#avatarContainer.default-avatar{background:#fff}
#avatarContainer .avatar-inner{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:transparent}
#avatarContainer.default-avatar .avatar-inner{background:#555!important;mask-image:url('/svg/avatar.svg?v=202608161200');-webkit-mask-image:url('/svg/avatar.svg?v=202608161200');mask-size:contain;-webkit-mask-size:contain;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center}
#avatarContainer.default-avatar .avatar-inner img{display:none}
#avatarContainer.qq-avatar .avatar-inner{background-color:transparent!important;mask-image:none!important;-webkit-mask-image:none!important;background-repeat:no-repeat;background-position:center;background-size:cover}
#avatarContainer.qq-avatar .avatar-inner img{display:none}
.title{font-size:18px;font-weight:600;margin-bottom:20px;text-align:center;color:#0a0a0a;display:flex;align-items:center;justify-content:center;gap:8px}
.info-box{background:#f8f8f8;border-radius:10px;padding:18px 20px;margin-bottom:16px}
.info-box p{margin:6px 0;font-size:15px;color:#333;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.info-box p .icon{opacity:.6}
.info-box span{color:#0a0a0a;font-weight:600}
.gray-text{color:#999!important;font-weight:400!important}
.stats-box{background:#f8f8f8;border-radius:10px;padding:12px 20px;margin-bottom:16px;display:flex;justify-content:space-between}
.stats-box .stat-item{text-align:center;flex:1}
.stats-box .stat-item .num{font-size:14px;font-weight:700;color:#0a0a0a}
.stats-box .stat-item .label{font-size:14px;color:#0a0a0a;font-weight:600;margin-top:2px;display:flex;align-items:center;justify-content:center;gap:4px}
.btn-row-custom{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;margin-bottom:16px}
.btn-row-custom .btn,.btn-row .btn,.modal .btn-row-modal .btn{background:#0a0a0a;color:#fff;border:none;cursor:pointer;transition:background .3s;display:flex;align-items:center;justify-content:center}
.btn-row-custom .btn{padding:6px 0;border-radius:6px;font-size:12px;font-weight:600;gap:4px}
.btn-row-custom .btn:hover,.btn-row .btn:hover,.modal .btn-row-modal .btn-confirm:hover{background:#222}
.btn-row-custom .btn:disabled{opacity:.6;cursor:not-allowed}
.btn-row-custom .btn .icon,.btn-row-custom .btn .icon-sm,.btn-row-custom .btn .icon-md,.btn-row .btn .icon,.btn-row .btn .icon-sm,.btn-row .btn .icon-md,.modal .btn-row-modal .btn-confirm .icon{filter:brightness(0)invert(1)}
.signature-row,.gender-row{display:flex;align-items:center;justify-content:flex-start;margin:6px 0;font-size:15px;color:#333;gap:4px;flex-wrap:wrap}
.signature-row .signature-text,.gender-row .gender-text{color:#0a0a0a;font-weight:600}
.signature-row .signature-btn,.gender-row .gender-btn,.info-box .qq-btn{padding:1px 5px;background:#0a0a0a;color:#fff;border:none;border-radius:3px;cursor:pointer;font-size:11px;transition:background .2s;flex-shrink:0;height:20px;display:inline-flex;align-items:center;justify-content:center;line-height:1}
.signature-row .signature-btn:hover,.gender-row .gender-btn:hover,.info-box .qq-btn:hover{background:#222}
.btn-row{display:flex;gap:10px}
.btn-row .btn{flex:1;padding:14px;border-radius:10px;font-size:15px;font-weight:700;gap:8px}
.btn-row .btn-danger{background:#d9534f}
.btn-row .btn-danger:hover{background:#c9302c}
.btn-row .btn-danger .icon,.btn-row .btn-danger .icon-sm,.btn-row .btn-danger .icon-md{filter:brightness(0)invert(1)}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:999;justify-content:center;align-items:center}
.modal-overlay.active{display:flex}
.modal{background:#fff;border-radius:16px;padding:30px 24px;width:90%;max-width:340px;box-shadow:0 8px 40px rgba(0,0,0,0.2)}
.modal h3{font-size:18px;margin-bottom:16px;text-align:center;display:flex;align-items:center;justify-content:center;gap:8px}
.modal h3 .icon-big{width:24px;height:24px;display:inline-block;vertical-align:middle;flex-shrink:0;filter:brightness(0)saturate(100%)}
.modal .input-box{margin-bottom:16px;position:relative}
.modal .input-box input,.modal .input-box textarea{width:100%;padding:12px 14px;border:1px solid #ddd;border-radius:8px;font-size:15px;outline:none;font-family:inherit;background:#fff}
.modal .input-box input:focus,.modal .input-box textarea:focus{border-color:#0a0a0a}
.modal .input-box .char-count-inner{position:absolute;bottom:8px;right:10px;font-size:11px;color:#aaa;pointer-events:none}
.modal .btn-row-modal{display:flex;gap:10px;margin-top:16px}
.modal .btn-row-modal .btn{flex:1;padding:12px;border-radius:8px;font-size:15px;font-weight:600}
.modal .btn-row-modal .btn-confirm{background:#0a0a0a;color:#fff}
.modal .btn-row-modal .btn-cancel{background:#f0f0f0;color:#333}
.modal .btn-row-modal .btn-cancel:hover{background:#e0e0e0}
.fold-section{background:#f8f8f8;border:1px solid #e5e5e5;border-radius:8px;margin:8px 0 12px;overflow:hidden}
.fold-header{padding:10px 14px;background:#f8f8f8;display:flex;justify-content:space-between;align-items:center;cursor:pointer;user-select:none;font-size:14px;font-weight:600;color:#333}
.fold-header .icon{margin-right:6px}
.fold-body{padding:12px 14px;border-top:1px solid #e5e5e5;background:#fff;display:none}
.fold-body.open{display:block}
/* 新增：性别切换图标旋转样式 */
.gender-switch-icon {
  transition: transform 0.3s ease;
  transform: rotate(0deg);
}
.gender-switch-icon.open {
  transform: rotate(90deg);
}
.gender-options{display:flex;flex-direction:column;gap:6px}
.gender-option{display:block;width:100%;padding:6px 20px;border:1px solid #ddd;border-radius:8px;cursor:pointer;font-size:15px;transition:all .2s;background:#f8f8f8;color:#333;text-align:center;user-select:none}
.gender-option:hover{background:#e5e5e5}
.gender-option.selected{background:#fff;color:#000;border-color:#000}
.ranking-modal .ranking-list,.announce-modal .announce-content{max-height:400px;overflow-y:auto}
.ranking-modal .rank-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f1f3f5}
.ranking-modal .rank-item:last-child{border-bottom:none}
.ranking-modal .rank-item .rank-num{font-weight:700;color:#0a0a0a;min-width:28px;font-size:13px}
.ranking-modal .rank-item .rank-avatar{width:28px;height:28px;border-radius:50%;flex-shrink:0;overflow:hidden;background:#ddd}
.ranking-modal .rank-item .rank-avatar img{width:100%;height:100%;object-fit:cover;display:block}
.ranking-modal .rank-item .rank-avatar-default{background:#555!important;mask-image:url('/svg/avatar.svg?v=202608161200');-webkit-mask-image:url('/svg/avatar.svg?v=202608161200');mask-size:contain;-webkit-mask-size:contain;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center}
.ranking-modal .rank-item .rank-info{flex:1;display:flex;align-items:center;justify-content:space-between;gap:8px}
.ranking-modal .rank-item .rank-name{font-weight:600;color:#0a0a0a;font-size:13px;flex-shrink:0}
.ranking-modal .rank-item .rank-stats{display:flex;align-items:center;gap:12px;font-weight:700;color:#0a0a0a;font-size:12px;flex-shrink:0}
.ranking-modal .rank-item .rank-stats span{display:flex;align-items:center;gap:4px}
.ranking-modal .rank-item .rank-stats .icon{width:12px;height:12px;filter:brightness(0)saturate(100%)}
.ranking-modal .close-btn,.announce-modal .close-btn{margin-top:16px;width:100%;padding:12px;background:#0a0a0a;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer}
.ranking-modal .close-btn .icon{filter:brightness(0)invert(1)}
.ranking-modal .close-btn:hover,.announce-modal .close-btn:hover{background:#222}
.ranking-modal .loading-spinner,.announce-modal .loading-spinner{text-align:center;padding:30px 0;color:#aaa;display:flex;flex-direction:column;align-items:center;gap:8px}
.ranking-modal .loading-spinner .icon,.announce-modal .loading-spinner .icon{width:28px;height:28px;filter:grayscale(1) opacity(0.6)}
.announce-modal .announce-content{padding:8px 0}
.announce-modal .announce-content .ann-title{font-size:16px;font-weight:600;margin-bottom:8px}
.announce-modal .announce-content .ann-body{font-size:14px;color:#333;white-space:pre-wrap;word-break:break-word}
input[type="checkbox"]{accent-color:#000}
.hidden{display:none}
.modal-wide{max-width:400px}
#signatureInput{padding-right:50px}
</style>
</head>
<body>
<div class="bg-grid"></div>
<div class="container">
<div class="avatar-section">
<div id="avatarContainer" class="default-avatar">
<div class="avatar-inner" id="avatarInner">
  <img src="/svg/avatar.svg?v=202608161200" class="hidden" alt="默认头像">
</div>
</div>
</div>
<div class="title"><img src="/svg/user.svg" class="icon" alt=""> 账号设置</div>
<div class="stats-box" id="statsBox">
<div class="stat-item"><div class="num" id="rankDisplay">--</div><div class="label"><img src="/svg/ranking.svg" class="icon-sm" alt="">排名</div></div>
<div class="stat-item"><div class="num" id="pointsDisplay">0</div><div class="label"><img src="/svg/coins.svg" class="icon-sm" alt="">积分</div></div>
</div>
<div class="info-box">
<p><img src="/svg/user.svg" class="icon" alt="">账号:<span id="profileUsername">––</span></p>
<p class="signature-row"><span><img src="/svg/sign.svg" class="icon" alt=""> 签名:<span class="signature-text" id="profileSignature">––</span></span><button class="signature-btn" id="editSignatureBtn">修改</button></p>
<p class="gender-row"><span><img src="/svg/gender.svg" class="icon" alt=""> 性别:<span class="gender-text" id="profileGender">––</span></span><button class="gender-btn" id="editGenderBtn">修改</button></p>
<p><img src="/svg/email.svg" class="icon" alt="">邮箱:<span id="profileEmail">––</span></p>
<p><img src="/svg/time.svg" class="icon" alt="">注册时间:<span id="profileCreatedAt">––</span></p>
<p><img src="/svg/qq.svg" class="icon-gray" alt="">绑定QQ:<span id="qqStatus">––</span><button class="qq-btn" id="qqBindBtn">修改</button></p>
</div>
<div class="btn-row-custom">
<button class="btn" id="checkinBtn"><img src="/svg/calendar.svg" class="icon-sm" alt="">签到</button>
<button class="btn" id="transferBtn"><img src="/svg/transfer.svg" class="icon-sm" alt="">转账</button>
<button class="btn" id="rankingBtn"><img src="/svg/ranking.svg" class="icon-sm" alt="">排行榜</button>
<button class="btn" id="announceBtn"><img src="/svg/notice.svg" class="icon-sm" alt="">公告</button>
</div>
<div class="btn-row">
<button class="btn" id="backBtn"><img src="/svg/return.svg" class="icon" alt=""> 返回</button>
<button class="btn btn-danger" id="logoutBtn"><img src="/svg/exit.svg" class="icon" alt=""> 退出登录</button>
</div>
</div>

<!-- 模态框 -->
<div class="modal-overlay" id="qqModal"><div class="modal"><h3><img src="/svg/qq.svg" class="icon" alt=""> 绑定QQ</h3><div class="input-box"><input type="text" id="qqInput" placeholder="请输入QQ号" maxlength="11"></div><div class="btn-row-modal"><button class="btn btn-cancel" id="qqModalCancel">取消</button><button class="btn btn-confirm" id="qqModalConfirm">确认绑定</button></div></div></div>
<div class="modal-overlay" id="signatureModal"><div class="modal"><h3><img src="/svg/sign.svg" class="icon" alt=""> 修改签名</h3><div class="input-box"><textarea id="signatureInput" placeholder="请输入签名（1-20个字）" maxlength="20" rows="2"></textarea><div class="char-count-inner"><span id="charCount">0</span>/20</div></div><div class="btn-row-modal"><button class="btn btn-cancel" id="signatureModalCancel">取消</button><button class="btn btn-confirm" id="signatureModalConfirm">确认修改</button></div></div></div>
<div class="modal-overlay" id="genderModal"><div class="modal"><h3><img src="/svg/gender.svg" class="icon" alt=""> 修改性别</h3><div class="fold-section"><div class="fold-header" id="genderFoldHeader"><span><img src="/svg/gender.svg" class="icon" alt=""> 选择性别</span><span id="genderFoldArrow"><img src="/svg/switch.svg" class="icon gender-switch-icon" alt=""></span></div><div class="fold-body" id="genderFoldBody"><div class="gender-options" id="genderOptions"><div class="gender-option" data-value="男">男</div><div class="gender-option" data-value="女">女</div><div class="gender-option" data-value="其他">其他</div><div class="gender-option" data-value="不愿透露">不愿透露</div></div></div></div><div class="btn-row-modal"><button class="btn btn-cancel" id="genderModalCancel">取消</button><button class="btn btn-confirm" id="genderModalConfirm">确认修改</button></div></div></div>
<div class="modal-overlay ranking-modal" id="rankingModal"><div class="modal modal-wide"><h3><img src="/svg/ranking.svg" class="icon" alt=""> 排行榜</h3><div class="ranking-list" id="rankingList"><div class="loading-spinner"><img src="/svg/loading.svg" class="icon spinner" alt="">加载中...</div></div><button class="close-btn" id="rankingCloseBtn"><img src="/svg/return.svg" class="icon" alt=""> 关闭</button></div></div>
<div class="modal-overlay announce-modal" id="announceModal"><div class="modal modal-wide"><h3><img src="/svg/notice.svg" class="icon-big" alt=""> 公告</h3><div class="announce-content" id="announceContent"><div class="loading-spinner"><img src="/svg/loading.svg" class="icon spinner" alt="">加载中...</div></div><button class="close-btn" id="announceCloseBtn"><img src="/svg/return.svg" class="icon" alt=""> 关闭</button></div></div>
<div class="modal-overlay" id="transferModal"><div class="modal"><h3><img src="/svg/transfer.svg" class="icon" alt=""> 转账</h3><div class="input-box"><input type="text" id="transferTarget" placeholder="目标用户名"></div><div class="input-box"><input type="number" id="transferPoints" placeholder="积分" min="1" step="1"></div><div class="btn-row-modal"><button class="btn btn-cancel" id="transferCancel">取消</button><button class="btn btn-confirm" id="transferConfirm">确定</button></div></div></div>

<script src="/api/toast.js"></script>
<script>
async function apiCall(url,method,body){try{const opts={method:method||'GET',headers:{'Content-Type':'application/json'},credentials:'include'};if(body)opts.body=JSON.stringify(body);const res=await fetch(url,opts);return await res.json()}catch(e){return{success:false,error:'网络连接失败，请重试'}}}
const $=id=>document.getElementById(id),usernameEl=$('profileUsername'),emailEl=$('profileEmail'),signatureEl=$('profileSignature'),genderEl=$('profileGender'),createdAtEl=$('profileCreatedAt'),avatarContainer=$('avatarContainer'),avatarInner=$('avatarInner'),qqStatus=$('qqStatus'),rankDisplay=$('rankDisplay'),pointsDisplay=$('pointsDisplay'),qqBindBtn=$('qqBindBtn'),logoutBtn=$('logoutBtn'),backBtn=$('backBtn'),editSignatureBtn=$('editSignatureBtn'),editGenderBtn=$('editGenderBtn'),checkinBtn=$('checkinBtn'),rankingBtn=$('rankingBtn'),announceBtn=$('announceBtn'),transferBtn=$('transferBtn'),qqModal=$('qqModal'),qqInput=$('qqInput'),qqModalConfirm=$('qqModalConfirm'),qqModalCancel=$('qqModalCancel'),signatureModal=$('signatureModal'),signatureInput=$('signatureInput'),charCount=$('charCount'),signatureModalConfirm=$('signatureModalConfirm'),signatureModalCancel=$('signatureModalCancel'),genderModal=$('genderModal'),genderOptions=$('genderOptions'),genderModalConfirm=$('genderModalConfirm'),genderModalCancel=$('genderModalCancel'),genderFoldHeader=$('genderFoldHeader'),genderFoldBody=$('genderFoldBody'),genderFoldArrow=$('genderFoldArrow'),rankingModal=$('rankingModal'),rankingList=$('rankingList'),rankingCloseBtn=$('rankingCloseBtn'),announceModal=$('announceModal'),announceContent=$('announceContent'),announceCloseBtn=$('announceCloseBtn'),transferModal=$('transferModal'),transferTarget=$('transferTarget'),transferPoints=$('transferPoints'),transferCancel=$('transferCancel'),transferConfirm=$('transferConfirm');
let currentQQ='',currentSignature='',currentGender='',selectedGender='',foldOpen=false;
function genderColor(g){return g=='男'?'#1677ff':g=='女'?'#ff69b4':g=='其他'?'#ffc107':'#888'}
function updateAvatar(qq,g){const c=genderColor(g);avatarContainer.style.borderColor=c;avatarContainer.classList.remove('default-avatar','qq-avatar');avatarInner.style.backgroundImage='';avatarInner.style.backgroundSize='';avatarInner.style.backgroundColor='';avatarInner.style.maskImage='';avatarInner.style.webkitMaskImage='';avatarInner.innerHTML='';if(qq){avatarContainer.classList.add('qq-avatar');avatarInner.style.backgroundImage=`url(https://q1.qlogo.cn/g?b=qq&nk=${qq}&s=640)`;avatarInner.style.backgroundSize='cover'}else{avatarContainer.classList.add('default-avatar')}}
function updateSignatureDisplay(t){signatureEl.textContent=t;t==='未填写'?signatureEl.classList.add('gray-text'):signatureEl.classList.remove('gray-text')}
function updateGenderDisplay(t){genderEl.textContent=t;t==='不愿透露'?genderEl.classList.add('gray-text'):genderEl.classList.remove('gray-text')}
function updateRankDisplay(r,p){rankDisplay.textContent=(p>0&&r)?'#'+r:'未上榜'}
async function loadProfile(){const r=await apiCall('/api/user','GET');if(r.success){usernameEl.textContent=r.username;emailEl.textContent=r.email;currentSignature=r.signature||'未填写';updateSignatureDisplay(currentSignature);currentGender=r.gender||'不愿透露';updateGenderDisplay(currentGender);createdAtEl.textContent=r.created_at||'未知';currentQQ=r.qq_number||'';pointsDisplay.textContent=r.total_points||0;updateRankDisplay(r.rank,r.total_points);if(currentQQ){qqStatus.textContent=currentQQ;qqStatus.className='qq-status'}else{qqStatus.textContent='未绑定';qqStatus.className='qq-status unbind'}updateAvatar(currentQQ,currentGender);
toast.success('账号数据已加载');
}else{window.location.href='/login'}}
signatureInput.addEventListener('input',function(){charCount.textContent=this.value.length});
editSignatureBtn.addEventListener('click',()=>{signatureInput.value=currentSignature==='未填写'?'':currentSignature;charCount.textContent=signatureInput.value.length;signatureModal.classList.add('active')});
signatureModalCancel.addEventListener('click',()=>signatureModal.classList.remove('active'));
signatureModalConfirm.addEventListener('click',async()=>{let s=signatureInput.value.trim();if(!s)s='未填写';const r=await apiCall('/api/update-signature','POST',{signature:s});if(r.success){toast.success('签名修改成功！');currentSignature=r.signature;updateSignatureDisplay(currentSignature);signatureModal.classList.remove('active')}else{toast.error(r.error||'修改失败')}});
signatureModal.addEventListener('click',e=>{if(e.target===signatureModal)signatureModal.classList.remove('active')});
// 修改折叠点击事件：不再替换 innerHTML，而是切换图标旋转类
genderFoldHeader.addEventListener('click',()=>{
    foldOpen=!foldOpen;
    genderFoldBody.classList.toggle('open');
    const icon = genderFoldArrow.querySelector('.gender-switch-icon');
    if(icon) icon.classList.toggle('open');
});
genderOptions.addEventListener('click',e=>{const o=e.target.closest('.gender-option');if(!o)return;document.querySelectorAll('.gender-option').forEach(el=>el.classList.remove('selected'));o.classList.add('selected');selectedGender=o.dataset.value});
editGenderBtn.addEventListener('click',()=>{
    foldOpen=false;
    genderFoldBody.classList.remove('open');
    // 重置图标旋转
    const icon = genderFoldArrow.querySelector('.gender-switch-icon');
    if(icon) icon.classList.remove('open');
    document.querySelectorAll('.gender-option').forEach(el=>el.classList.remove('selected'));
    let found=false;
    document.querySelectorAll('.gender-option').forEach(el=>{
        if(el.dataset.value===currentGender){
            el.classList.add('selected');
            selectedGender=currentGender;
            found=true;
        }
    });
    if(!found){
        const def=document.querySelector('.gender-option[data-value="不愿透露"]');
        if(def){def.classList.add('selected');selectedGender='不愿透露'}
    }
    genderModal.classList.add('active')
});
genderModalCancel.addEventListener('click',()=>genderModal.classList.remove('active'));
genderModalConfirm.addEventListener('click',async()=>{const sel=document.querySelector('.gender-option.selected');if(!sel){toast.error('请先展开并选择性别');return}const g=sel.dataset.value;const r=await apiCall('/api/update-gender','POST',{gender:g});if(r.success){toast.success('性别修改成功！');currentGender=r.gender;updateGenderDisplay(currentGender);updateAvatar(currentQQ,currentGender);genderModal.classList.remove('active')}else{toast.error(r.error||'修改失败')}});
genderModal.addEventListener('click',e=>{if(e.target===genderModal)genderModal.classList.remove('active')});
qqBindBtn.addEventListener('click',()=>{qqInput.value=currentQQ;qqModal.classList.add('active')});
qqModalCancel.addEventListener('click',()=>qqModal.classList.remove('active'));
qqModalConfirm.addEventListener('click',async()=>{const q=qqInput.value.trim();if(!q){toast.error('请输入QQ号');return}if(!/^\d{5,11}$/.test(q)){toast.error('请输入正确的QQ号');return}const r=await apiCall('/api/bind-qq','POST',{qq_number:q});if(r.success){toast.success('QQ绑定成功！');qqModal.classList.remove('active');loadProfile()}else{toast.error(r.error||'绑定失败')}});
qqModal.addEventListener('click',e=>{if(e.target===qqModal)qqModal.classList.remove('active')});
checkinBtn.addEventListener('click',async()=>{checkinBtn.disabled=true;checkinBtn.innerHTML='<img src="/svg/loading.svg" class="icon-sm spinner" alt=""> 签到中...';const r=await apiCall('/api/checkin','POST');if(r.success){toast.success(r.message);pointsDisplay.textContent=r.total;loadProfile()}else{toast.error(r.error||'签到失败')}checkinBtn.disabled=false;checkinBtn.innerHTML='<img src="/svg/calendar.svg" class="icon-sm" alt="">签到'});

// 排行榜
rankingBtn.addEventListener('click',async()=>{
    rankingModal.classList.add('active');
    rankingList.innerHTML='<div class="loading-spinner"><img src="/svg/loading.svg" class="icon spinner" alt="">加载中...</div>';
    const r=await apiCall('/api/ranking','GET');
    if(r.success && r.ranking){
        let html='';
        r.ranking.forEach(item=>{
            let avatarHtml;
            if(item.avatar_url){
                avatarHtml = `<div class="rank-avatar" data-username="${item.username}" style="cursor:pointer;"><img src="${item.avatar_url}" alt="头像"></div>`;
            }else{
                avatarHtml = `<div class="rank-avatar rank-avatar-default" data-username="${item.username}" style="cursor:pointer;"></div>`;
            }
            html += `<div class="rank-item">
                <span class="rank-num">#${item.rank}</span>
                ${avatarHtml}
                <div class="rank-info">
                    <span class="rank-name">${item.username}</span>
                    <span class="rank-stats">
                        <span><img src="/svg/calendar.svg" class="icon-sm" alt=""> ${item.checkin_days}</span>
                        <span><img src="/svg/coins.svg" class="icon-sm" alt=""> ${item.total_points}</span>
                    </span>
                </div>
            </div>`;
        });
        rankingList.innerHTML = html;
        rankingList.querySelectorAll('.rank-avatar, .rank-avatar-default').forEach(el => {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
                const username = this.dataset.username;
                if(username) window.location.href = '/user?id=' + username;
            });
        });
        toast.success('排行榜加载成功');
    }else{
        rankingList.innerHTML='<div style="text-align:center;padding:20px;color:#aaa;">暂无数据</div>';
    }
});
rankingCloseBtn.addEventListener('click',()=>rankingModal.classList.remove('active'));
rankingModal.addEventListener('click',e=>{if(e.target===rankingModal)rankingModal.classList.remove('active')});

// 公告
announceBtn.addEventListener('click',async()=>{
    announceModal.classList.add('active');
    announceContent.innerHTML='<div class="loading-spinner"><img src="/svg/loading.svg" class="icon spinner" alt="">加载中...</div>';
    const r=await apiCall('/api/announcement','GET');
    if(r.success){
        let html='';
        if(r.is_active){
            html=`<div class="ann-title">${r.title||'公告'}</div><div class="ann-body">${r.content||''}</div>`;
        }else{
            html='<div style="text-align:center;padding:20px;color:#aaa;">暂无公告</div>';
        }
        announceContent.innerHTML=html;
        toast.success('公告获取成功');
    }else{
        announceContent.innerHTML='<div style="text-align:center;padding:20px;color:#aaa;">加载失败</div>';
    }
});
announceCloseBtn.addEventListener('click',()=>announceModal.classList.remove('active'));
announceModal.addEventListener('click',e=>{if(e.target===announceModal)announceModal.classList.remove('active')});

transferBtn.addEventListener('click',()=>{transferTarget.value='';transferPoints.value='';transferModal.classList.add('active')});
transferCancel.addEventListener('click',()=>transferModal.classList.remove('active'));
transferConfirm.addEventListener('click',async()=>{const t=transferTarget.value.trim(),p=transferPoints.value.trim();if(!t){toast.error('请输入目标用户名');return}if(!p){toast.error('请输入积分');return}const n=parseInt(p,10);if(isNaN(n)||n<=0){toast.error('积分必须是正整数');return}const r=await apiCall('/api/transfer','POST',{target:t,points:n});if(r.success){toast.success('转账成功');transferModal.classList.remove('active');loadProfile()}else{toast.error(r.error||'转账失败')}});
transferModal.addEventListener('click',e=>{if(e.target===transferModal)transferModal.classList.remove('active')});
logoutBtn.addEventListener('click',async()=>{const r=await apiCall('/api/logout','POST');if(r.success){toast.success('已退出登录');setTimeout(()=>{window.location.href='/login'},500)}else{toast.error('退出失败')}});
backBtn.addEventListener('click',()=>{window.location.href='/'});
loadProfile();
</script>
</body>
</html>